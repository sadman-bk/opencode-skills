{
  "$schema": "https://opencode.ai/config.json",
  // Dogfood this checkout: load the plugin from the repo root (relative paths
  // resolve from this file; a bare ".." is read as an npm name, so keep the
  // trailing slash) with every non-deprecated bucket, so edits to a
  // SKILL.md are live in sessions opened here.
  "plugins": [
    {
      "package": "../",
      "options": { "buckets": ["engineering", "productivity", "in-progress", "misc"] }
    }
  ]
}
